# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/mediainfotech_db?sslmode=require"

# Server Port
PORT=4000

# Authentication JWT Secrets
JWT_SECRET="your-super-secret-access-token-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key"

# Client Web Application URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Company Branding & Configuration
COMPANY_NAME="Media Infotech"
COMPANY_LOGO_URL="/logo.png"
COMPANY_EMAIL="contact@mediainfotech.com"
COMPANY_PHONE="+91-9876543210"
COMPANY_ADDRESS="1/2 Satish Chakraborty Lane, Bally, Kolkata. 711201"

# SMTP Email Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="notifications@mediainfotech.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Media Infotech <notifications@mediainfotech.com>"
