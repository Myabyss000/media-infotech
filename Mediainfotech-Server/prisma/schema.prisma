generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & RBAC
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  ACCOUNTS
  HR
  EMPLOYEE
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           Role      @default(EMPLOYEE)
  designation    String?
  department     String?
  joiningDate    DateTime?
  isActive       Boolean   @default(true)
  lastLogin      DateTime?

  // Work Schedule & Shift Timings
  shiftStartTime  String?   @default("09:30") // Scheduled entry time (e.g. "09:30")
  shiftEndTime    String?   @default("18:30") // Scheduled exit time (e.g. "18:30")
  workDays        String?   @default("MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY,SATURDAY") // Scheduled workdays
  lateGracePeriod Int?      @default(15)     // Grace period in minutes

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  permissions       UserPermission[]
  tokens            Token[]
  sessions          Session[]
  auditLogs         AuditLog[]          @relation("actor")
  notifications     Notification[]

  // Attendance
  attendanceRecords Attendance[]

  // HR
  leaveRequests     LeaveRequest[]      @relation("requester")
  leaveApprovals    LeaveRequest[]      @relation("approver")
  assignedVehicles  VehicleAssignment[]
  payslips          Payslip[]

  // Groups
  groupMemberships  GroupMember[]
  createdGroups     Group[]             @relation("groupCreator")
  announcementsWritten GroupAnnouncement[]        @relation("announcementAuthor")
  announcementComments GroupAnnouncementComment[] @relation("announcementCommentAuthor")

  // Clients
  managedClients    Client[]            @relation("accountManager")

  // Tickets
  createdTickets    Ticket[]            @relation("ticketCreator")
}

model Permission {
  id          String   @id @default(cuid())
  module      String   // "attendance", "hr", "clients", "groups", "users", "tickets", "inventory", "holidays", etc.
  action      String   // "read", "create", "update", "delete", "approve"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

model Token {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  entityId  String?
  details   Json?
  actorId   String
  actor     User     @relation("actor", fields: [actorId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   // "info", "warning", "success", "error"
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  link      String?
  createdAt DateTime @default(now())
}

// ============================================================================
// ATTENDANCE — GPS + Camera Verified
// ============================================================================

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Attendance {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date

  // Check-in
  checkInTime     DateTime
  checkInPhoto    String
  checkInLat      Float
  checkInLng      Float
  checkInAddress  String?
  checkInNote     String?

  // Check-out
  checkOutTime    DateTime?
  checkOutPhoto   String?
  checkOutLat     Float?
  checkOutLng     Float?
  checkOutAddress String?
  checkOutNote    String?

  // Status & Calculations
  status           AttendanceStatus @default(PENDING)
  totalHours       Float?
  overtimeHours    Float?

  // Late Entry & Early Exit Tracking
  isLate           Boolean          @default(false)
  lateMinutes      Int              @default(0)
  isEarlyExit      Boolean          @default(false)
  earlyExitMinutes Int              @default(0)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, date])
}

model AttendanceSettings {
  id                         String   @id @default("default")
  officeLat                  Float    @default(0.0)
  officeLng                  Float    @default(0.0)
  geofenceRadius             Float    @default(50.0) // Radius in meters
  geofenceMode               String   @default("AUTO") // "AUTO" (Strict radius block) | "MANUAL" (Advisory/Manager approval)
  autoApproveWithinGeofence  Boolean  @default(true) // Automatically approve check-ins within geofence radius
  requirePhoto               Boolean  @default(true)
  allowRemoteCheckIn         Boolean  @default(true)
  officeStartTime            String   @default("09:30")
  officeEndTime              String   @default("18:30")
  lateThresholdMinutes       Int      @default(15)
  updatedBy                  String?
  updatedAt                  DateTime @updatedAt
}

// ============================================================================
// HR CENTRE — Leave, Vehicles, Payslips, Holidays
// ============================================================================

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  COMPENSATORY
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("requester", fields: [userId], references: [id], onDelete: Cascade)
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  totalDays     Float
  reason        String
  status        LeaveStatus @default(PENDING)

  approvedBy    String?
  approver      User?       @relation("approver", fields: [approvedBy], references: [id])
  approvedAt    DateTime?
  rejectionNote String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model LeaveBalance {
  id        String    @id @default(cuid())
  userId    String
  type      LeaveType
  year      Int
  total     Float
  used      Float     @default(0)
  remaining Float

  @@unique([userId, type, year])
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

model Vehicle {
  id              String              @id @default(cuid())
  registrationNo  String              @unique
  type            String
  make            String
  model           String
  year            Int?
  fuelType        String?
  status          VehicleStatus       @default(AVAILABLE)
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  notes           String?

  assignments     VehicleAssignment[]
  tickets         Ticket[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model VehicleAssignment {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())
  returnedAt  DateTime?
  purpose     String?
  notes       String?
}

model Payslip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  basicPay    Float?
  allowances  Float?
  deductions  Float?
  netPay      Float?
  filePath    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month, year])
}

enum HolidayType {
  NATIONAL
  COMPANY
  REGIONAL
  OPTIONAL
}

model Holiday {
  id          String      @id @default(cuid())
  name        String
  date        DateTime    @db.Date
  year        Int
  type        HolidayType @default(COMPANY)
  description String?
  isMandatory Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([date, name])
}

// ============================================================================
// CLIENT MANAGEMENT
// ============================================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

model Client {
  id               String              @id @default(cuid())
  name             String
  companyName      String?
  email            String?
  phone            String
  altPhone         String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  gstNumber        String?
  status           ClientStatus        @default(ACTIVE)

  accountManagerId String?
  accountManager   User?               @relation("accountManager", fields: [accountManagerId], references: [id])

  services         ClientService[]
  transactions     ClientTransaction[]
  businessHistory  BusinessHistory[]
  tickets          Ticket[]
  groups           Group[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model ServiceType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ClientService {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceTypeId String
  serviceName   String
  startDate     DateTime?
  endDate       DateTime?
  amount        Float?
  status        String      @default("active")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ClientTransaction {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  amount      Float
  description String?
  referenceNo String?
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
}

model BusinessHistory {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  date        DateTime @db.Date
  createdBy   String
  createdAt   DateTime @default(now())
}

// ============================================================================
// GROUPS
// ============================================================================

model Group {
  id              String        @id @default(cuid())
  name            String        @unique
  description     String?
  color           String?
  createdById     String
  createdBy       User          @relation("groupCreator", fields: [createdById], references: [id])
  isActive        Boolean       @default(true)

  // Location & Site Service fields
  locationName    String?
  locationAddress String?
  latitude        Float?
  longitude       Float?
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  members         GroupMember[]
  tickets         Ticket[]
  announcements   GroupAnnouncement[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

// ============================================================================
// GROUP ANNOUNCEMENTS & TASK GUIDELINES
// ============================================================================

enum GroupAnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model GroupAnnouncement {
  id          String                    @id @default(cuid())
  groupId     String
  group       Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                      @relation("announcementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  content     String
  doList      String?                   // Task Guidelines: What to do
  dontList    String?                   // Task Guidelines: What NOT to do
  priority    GroupAnnouncementPriority @default(NORMAL)
  pinned      Boolean                   @default(false)

  comments    GroupAnnouncementComment[]

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model GroupAnnouncementComment {
  id             String            @id @default(cuid())
  announcementId String
  announcement   GroupAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation("announcementCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  content        String
  createdAt      DateTime          @default(now())
}

// ============================================================================
// INVENTORY MANAGEMENT
// ============================================================================

enum InventoryCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  DEFECTIVE
}

enum InventoryStatus {
  IN_STOCK
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED
}

model InventoryItem {
  id           String             @id @default(cuid())
  deviceName   String
  modelNumber  String?
  barcode      String             @unique
  category     String?
  condition    InventoryCondition @default(NEW)
  status       InventoryStatus    @default(IN_STOCK)
  buyDate      DateTime?          @db.Date
  stockAmount  Int                @default(1)
  unitPrice    Float?
  supplier     String?
  notes        String?

  tickets      TicketInventoryItem[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model TicketInventoryItem {
  id              String        @id @default(cuid())
  ticketId        String
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int           @default(1)
  notes           String?
  assignedAt      DateTime      @default(now())

  @@unique([ticketId, inventoryItemId])
}

// ============================================================================
// TICKETING SYSTEM
// ============================================================================

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  title           String
  description     String
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)

  // Creator
  createdById     String
  createdBy       User           @relation("ticketCreator", fields: [createdById], references: [id])

  // Assigned Group
  assignedGroupId String?
  assignedGroup   Group?         @relation(fields: [assignedGroupId], references: [id], onDelete: SetNull)

  // Linked Client
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Linked Vehicle
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Assigned Inventory Devices
  inventoryItems  TicketInventoryItem[]

  // Resolution Notes
  resolutionNote String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
