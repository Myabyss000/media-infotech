generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTH & RBAC
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  ACCOUNTS
  HR
  EMPLOYEE
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  avatar         String?
  role           Role      @default(EMPLOYEE)
  designation    String?
  department     String?
  joiningDate    DateTime?
  isActive       Boolean   @default(true)
  lastLogin      DateTime?

  // Work Schedule & Shift Timings
  shiftStartTime  String?   @default("09:30") // Scheduled entry time (e.g. "09:30")
  shiftEndTime    String?   @default("18:30") // Scheduled exit time (e.g. "18:30")
  workDays        String?   @default("MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY,SATURDAY") // Scheduled workdays
  lateGracePeriod Int?      @default(15)     // Grace period in minutes

  // HR & Lifecycle Details
  employeeCode           String?   @unique
  gender                 String?
  dob                    DateTime?
  maritalStatus          String?
  bloodGroup             String?
  address                String?
  city                   String?
  state                  String?
  postalCode             String?
  emergencyContactName   String?
  emergencyContactRelation String?
  emergencyContactPhone  String?
  panNumber              String?
  aadhaarNumber          String?
  bankName               String?
  bankAccountNumber      String?
  bankIfsc               String?
  bankBranch             String?
  employmentType         String?   @default("FULL_TIME") // "FULL_TIME", "PART_TIME", "CONTRACT", "INTERN"
  probationPeriodMonths  Int?      @default(3)
  confirmationDate       DateTime?
  resignationDate        DateTime?
  exitDate               DateTime?
  ctcAnnual              Float?

  // Reporting Hierarchy
  managerId              String?
  manager                User?     @relation("reportingHierarchy", fields: [managerId], references: [id])
  directReports          User[]    @relation("reportingHierarchy")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  permissions       UserPermission[]
  tokens            Token[]
  sessions          Session[]
  auditLogs         AuditLog[]          @relation("actor")
  notifications     Notification[]

  // Attendance & Shifts
  attendanceRecords           Attendance[]
  regularizationsRequested    AttendanceRegularization[] @relation("regularizationRequester")
  regularizationsReviewed     AttendanceRegularization[] @relation("regularizationReviewer")
  assignedShiftId             String?
  assignedShift               Shift?                     @relation("userAssignedShift", fields: [assignedShiftId], references: [id])
  shiftSchedules              ShiftSchedule[]
  shiftSwapsRequested         ShiftSwapRequest[]         @relation("swapRequester")
  shiftSwapsTargeted          ShiftSwapRequest[]         @relation("swapTargetUser")
  shiftSwapsApproved          ShiftSwapRequest[]         @relation("swapApprover")

  // HR Relations
  leaveRequests          LeaveRequest[]         @relation("requester")
  leaveApprovals         LeaveRequest[]         @relation("approver")
  leaveBalances          LeaveBalance[]
  assignedVehicles       VehicleAssignment[]
  payslips               Payslip[]
  documents              EmployeeDocument[]
  onboardingTasks        OnboardingTask[]
  expenseClaims          ExpenseClaim[]
  salaryStructure        EmployeeSalaryStructure?
  policyAcknowledgments  PolicyAcknowledgment[]

  // Groups
  groupMemberships  GroupMember[]
  createdGroups     Group[]             @relation("groupCreator")
  announcementsWritten GroupAnnouncement[]        @relation("announcementAuthor")
  announcementComments GroupAnnouncementComment[] @relation("announcementCommentAuthor")

  // Clients
  managedClients    Client[]            @relation("accountManager")

  // Inventory & Assets
  assignedInventoryItems InventoryItem[] @relation("userAssignedInventory")
  inventoryLogs          InventoryLog[]  @relation("inventoryLogUser")

  // Tickets
  createdTickets    Ticket[]            @relation("ticketCreator")
  assignedTickets   Ticket[]            @relation("assignedTicketUser")
  resolvedTickets   Ticket[]            @relation("resolvedTicketUser")
  ticketComments    TicketComment[]     @relation("ticketCommentAuthor")

  // Projects & Tenders
  managedProjects     Project[]         @relation("projectManager")
  createdProjects     Project[]         @relation("projectCreator")
  uploadedProjectDocs ProjectDocument[] @relation("projectDocUploader")

  // Real-Time Internal Team Chat
  chatParticipants    ChatParticipant[]
  sentChatMessages    ChatMessage[]     @relation("sentChatMessages")
  createdChatChannels ChatChannel[]     @relation("createdChatChannels")
  chatReactions       ChatMessageReaction[]
}

model Permission {
  id          String   @id @default(cuid())
  module      String   // "attendance", "hr", "clients", "groups", "users", "tickets", "inventory", "holidays", etc.
  action      String   // "read", "create", "update", "delete", "approve"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

model Token {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  entityId  String?
  details   Json?
  actorId   String
  actor     User     @relation("actor", fields: [actorId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())
}

// ============================================================================
// REAL-TIME NOTIFICATION SYSTEM (CATEGORIZED & PRIORITIZED)
// ============================================================================

enum NotificationCategory {
  TICKETS       // Breakdowns, SLA escalations, ticket assignments, status changes
  PROJECTS      // Milestone completions, site camera mounting, JIR sign-off, tender dates
  INVENTORY     // Barcode scan approvals, field kit dispatch, defect returns, low stock
  CHAT          // Team channel mentions, direct messages, urgent broadcasts
  ATTENDANCE_HR // Geofence check-in alerts, leave approvals, payroll generated
  SYSTEM        // Security alerts, role changes, audit alerts
}

enum NotificationPriority {
  URGENT        // Critical SLA breakdown, immediate defective item return alert
  HIGH          // Project deadline approaching, high-priority ticket
  NORMAL        // Standard milestone, chat message, inventory dispatched
  LOW           // Informational log
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  message     String
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(NORMAL)
  type        String?              // Backward compatibility: "info", "warning", "success", "error"
  
  isRead      Boolean              @default(false)
  readAt      DateTime?

  actionUrl   String?              // e.g. "/tickets", "/projects", "/inventory", "/chat"
  link        String?              // Backward compatibility
  entityId    String?              // Associated ID (Ticket ID, Project ID, etc.)
  entityType  String?              // "Ticket", "Project", "InventoryItem", "ChatMessage", "LeaveRequest"
  metadata    Json?                // JSON metadata for extra details

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt

  @@index([userId, isRead])
  @@index([userId, category])
  @@index([userId, priority])
  @@index([createdAt])
}

// ============================================================================
// ATTENDANCE & SHIFTS — GPS + Camera Verified, Breaks, Regularization, Rostering
// ============================================================================

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BreakType {
  LUNCH
  TEA
  MEETING
  PERSONAL
  OTHER
}

enum RegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RegularizationType {
  MISSED_CHECK_IN
  MISSED_CHECK_OUT
  FULL_DAY_CORRECTION
  CLIENT_VISIT
  TECHNICAL_GLITCH
  WORK_FROM_HOME
  OTHER
}

model Attendance {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date

  // Check-in
  checkInTime     DateTime
  checkInPhoto    String
  checkInLat      Float
  checkInLng      Float
  checkInAddress  String?
  checkInNote     String?

  // Check-out
  checkOutTime    DateTime?
  checkOutPhoto   String?
  checkOutLat     Float?
  checkOutLng     Float?
  checkOutAddress String?
  checkOutNote    String?

  // Breaks & Productive Hours
  breaks             AttendanceBreak[]
  totalBreakMinutes  Int              @default(0)
  productiveHours    Float?

  // Status & Calculations
  status             AttendanceStatus @default(PENDING)
  totalHours         Float?
  overtimeHours      Float?

  // Late Entry & Early Exit Tracking
  isLate             Boolean          @default(false)
  lateMinutes        Int              @default(0)
  isEarlyExit        Boolean          @default(false)
  earlyExitMinutes   Int              @default(0)

  // Regularization Tracking
  isRegularized      Boolean          @default(false)
  regularizationId   String?
  regularization     AttendanceRegularization? @relation(fields: [regularizationId], references: [id])

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId, status])
  @@index([status])
  @@index([date])
}

model AttendanceBreak {
  id              String     @id @default(cuid())
  attendanceId    String
  attendance      Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  type            BreakType  @default(LUNCH)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  note            String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model AttendanceRegularization {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation("regularizationRequester", fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime             @db.Date
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reasonType         RegularizationType   @default(MISSED_CHECK_IN)
  reason             String
  status             RegularizationStatus @default(PENDING)

  reviewedBy         String?
  reviewer           User?                @relation("regularizationReviewer", fields: [reviewedBy], references: [id])
  reviewedAt         DateTime?
  reviewNote         String?

  attendanceRecords  Attendance[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Shift {
  id                    String             @id @default(cuid())
  name                  String
  code                  String             @unique
  startTime             String             @default("09:30")
  endTime               String             @default("18:30")
  gracePeriod           Int                @default(15)
  halfDayThresholdHours Float              @default(4.0)
  color                 String             @default("#3b82f6")
  description           String?
  isActive              Boolean            @default(true)

  assignedUsers         User[]             @relation("userAssignedShift")
  schedules             ShiftSchedule[]
  swapRequestsFrom      ShiftSwapRequest[] @relation("swapFromShift")
  swapRequestsTo        ShiftSwapRequest[] @relation("swapToShift")

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model ShiftSchedule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

enum SwapRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ShiftSwapRequest {
  id           String            @id @default(cuid())
  requesterId  String
  requester    User              @relation("swapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?             @relation("swapTargetUser", fields: [targetUserId], references: [id])
  date         DateTime          @db.Date
  fromShiftId  String
  fromShift    Shift             @relation("swapFromShift", fields: [fromShiftId], references: [id], onDelete: Cascade)
  toShiftId    String
  toShift      Shift             @relation("swapToShift", fields: [toShiftId], references: [id], onDelete: Cascade)
  reason       String
  status       SwapRequestStatus @default(PENDING)
  approvedBy   String?
  approver     User?             @relation("swapApprover", fields: [approvedBy], references: [id])
  reviewNote   String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model AttendanceSettings {
  id                         String   @id @default("default")
  officeLat                  Float    @default(0.0)
  officeLng                  Float    @default(0.0)
  geofenceRadius             Float    @default(50.0) // Radius in meters
  geofenceMode               String   @default("AUTO") // "AUTO" (Strict radius block) | "MANUAL" (Advisory/Manager approval)
  autoApproveWithinGeofence  Boolean  @default(true) // Automatically approve check-ins within geofence radius
  requirePhoto               Boolean  @default(true)
  allowRemoteCheckIn         Boolean  @default(true)
  officeStartTime            String   @default("09:30")
  officeEndTime              String   @default("18:30")
  lateThresholdMinutes       Int      @default(15)
  updatedBy                  String?
  updatedAt                  DateTime @updatedAt
}

model CompanySettings {
  id                String   @id @default("default")
  name              String   @default("Media Infotech Private Limited")
  tagline           String   @default("Enterprise IT Solutions, Software Engineering & Cloud Infrastructure")
  address           String   @default("Corporate Tower, Suite 400, Sector 5, Salt Lake, Kolkata, WB - 700091")
  cin               String   @default("U72200WB2020PTC239871")
  gstin             String   @default("19AAECM4920M1Z8")
  email             String   @default("hr@mediainfotech.com")
  website           String   @default("www.mediainfotech.com")
  phone             String   @default("+91 33 4000 1234")
  logoUrl           String?  @default("/Icon.png")
  authorizedSigner  String   @default("Authorized Signatory / HR Dept.")
  updatedBy         String?
  updatedAt         DateTime @updatedAt
}

// ============================================================================
// HR CENTRE — Leave, Vehicles, Payslips, Holidays
// ============================================================================

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  COMPENSATORY
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("requester", fields: [userId], references: [id], onDelete: Cascade)
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  totalDays     Float
  reason        String
  status        LeaveStatus @default(PENDING)

  isHalfDay     Boolean     @default(false)
  halfDayPeriod String?     // "FIRST_HALF" | "SECOND_HALF"
  documentUrl   String?

  approvedBy    String?
  approver      User?       @relation("approver", fields: [approvedBy], references: [id])
  approvedAt    DateTime?
  rejectionNote String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([startDate, endDate])
}

model LeaveBalance {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            LeaveType
  year            Int
  total           Float
  used            Float     @default(0)
  remaining       Float

  lastUpdatedBy   String?
  lastAdjustedAt  DateTime?
  adjustmentNote  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, type, year])
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  type       String   // "OFFER_LETTER", "ID_PROOF", "ACADEMIC", "EXPERIENCE", "CONTRACT", "NDA", "OTHER"
  fileUrl    String
  fileSize   String?
  uploadedAt DateTime @default(now())
}

model OnboardingTask {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String    // "IT_SETUP", "DOCUMENTATION", "TRAINING", "HR_ORIENTATION", "OFFBOARDING"
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  assignedTo  String?
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CompanyPolicy {
  id             String                 @id @default(cuid())
  title          String
  category       String                 // "LEAVE_POLICY", "CODE_OF_CONDUCT", "IT_SECURITY", "POSH", "EXPENSE_POLICY", "GENERAL"
  summary        String?
  content        String?                @db.Text
  fileUrl        String?
  version        String                 @default("1.0")
  isMandatoryAck Boolean                @default(false)
  acknowledgments PolicyAcknowledgment[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model PolicyAcknowledgment {
  id             String        @id @default(cuid())
  policyId       String
  policy         CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime      @default(now())

  @@unique([policyId, userId])
}

model ExpenseClaim {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String    // "TRAVEL", "FOOD", "CLIENT_ENTERTAINMENT", "INTERNET", "OFFICE_SUPPLIES", "OTHER"
  amount        Float
  date          DateTime  @db.Date
  receiptUrl    String?
  description   String?
  status        String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "PAID"
  approvedBy    String?
  approvedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EmployeeSalaryStructure {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyCtc          Float
  basicPay            Float
  hra                 Float
  specialAllowance    Float
  conveyanceAllowance Float    @default(0)
  medicalAllowance    Float    @default(0)
  pfEmployee          Float    @default(0)
  pfEmployer          Float    @default(0)
  professionalTax     Float    @default(0)
  tds                 Float    @default(0)
  effectiveFrom       DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

model Vehicle {
  id              String              @id @default(cuid())
  registrationNo  String              @unique
  type            String
  make            String
  model           String
  year            Int?
  fuelType        String?
  status          VehicleStatus       @default(AVAILABLE)
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  notes           String?

  assignments            VehicleAssignment[]
  tickets                Ticket[]
  groups                 Group[]             @relation("groupAssignedVehicle")
  assignedInventoryItems InventoryItem[]
  projects               Project[]           @relation("projectAssignedVehicle")
  createdAt              DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model VehicleAssignment {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())
  returnedAt  DateTime?
  purpose     String?
  notes       String?
}

model Payslip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  basicPay    Float?
  allowances  Float?
  deductions  Float?
  netPay      Float?
  filePath    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month, year])
}

enum HolidayType {
  NATIONAL
  COMPANY
  REGIONAL
  OPTIONAL
}

model Holiday {
  id          String      @id @default(cuid())
  name        String
  date        DateTime    @db.Date
  year        Int
  type        HolidayType @default(COMPANY)
  description String?
  isMandatory Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([date, name])
}

// ============================================================================
// CLIENT MANAGEMENT
// ============================================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

model Client {
  id               String              @id @default(cuid())
  name             String
  companyName      String?
  email            String?
  phone            String
  altPhone         String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  gstNumber        String?
  status           ClientStatus        @default(ACTIVE)

  accountManagerId String?
  accountManager   User?               @relation("accountManager", fields: [accountManagerId], references: [id])

  services         ClientService[]
  transactions     ClientTransaction[]
  businessHistory  BusinessHistory[]
  tickets                Ticket[]
  groups                 Group[]
  assignedInventoryItems InventoryItem[]
  projects               Project[]           @relation("clientProjects")

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model ServiceType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ClientService {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceTypeId String
  serviceName   String
  startDate     DateTime?
  endDate       DateTime?
  amount        Float?
  status        String      @default("active")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ClientTransaction {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  amount      Float
  description String?
  referenceNo String?
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
}

model BusinessHistory {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  date        DateTime @db.Date
  createdBy   String
  createdAt   DateTime @default(now())
}

// ============================================================================
// GROUPS
// ============================================================================

model Group {
  id              String        @id @default(cuid())
  name            String        @unique
  description     String?
  color           String?
  createdById     String
  createdBy       User          @relation("groupCreator", fields: [createdById], references: [id])
  isActive        Boolean       @default(true)

  // Location & Site Service fields
  locationName    String?
  locationAddress String?
  latitude        Float?
  longitude       Float?
  clientId        String?
  client          Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Service Vehicle Assignment
  vehicleId       String?
  vehicle         Vehicle?      @relation("groupAssignedVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)

  members         GroupMember[]
  tickets         Ticket[]
  announcements   GroupAnnouncement[]
  inventoryItems  InventoryItem[]   @relation("groupAssignedInventory")
  projects        Project[]         @relation("groupAssignedProjects")
  chatChannels    ChatChannel[]     @relation("groupChatChannel")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

// ============================================================================
// GROUP ANNOUNCEMENTS & TASK GUIDELINES
// ============================================================================

enum GroupAnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

model GroupAnnouncement {
  id          String                    @id @default(cuid())
  groupId     String
  group       Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                      @relation("announcementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  content     String
  doList      String?                   // Task Guidelines: What to do
  dontList    String?                   // Task Guidelines: What NOT to do
  priority    GroupAnnouncementPriority @default(NORMAL)
  pinned      Boolean                   @default(false)

  comments    GroupAnnouncementComment[]

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model GroupAnnouncementComment {
  id             String            @id @default(cuid())
  announcementId String
  announcement   GroupAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation("announcementCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  content        String
  createdAt      DateTime          @default(now())
}

// ============================================================================
// INVENTORY MANAGEMENT
// ============================================================================

enum InventoryCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  DEFECTIVE
  NEEDS_REPAIR
}

enum InventoryStatus {
  IN_STOCK
  ASSIGNED
  UNDER_MAINTENANCE
  RETIRED
}

model InventoryItem {
  id             String             @id @default(cuid())
  deviceName     String
  modelNumber    String?
  barcode        String             @unique
  category       String?
  condition      InventoryCondition @default(NEW)
  status         InventoryStatus    @default(IN_STOCK)
  buyDate        DateTime?          @db.Date
  warrantyExpiry DateTime?          @db.Date
  invoiceNo      String?
  location       String?
  stockAmount    Int                @default(1)
  unitPrice      Float?
  supplier       String?
  notes          String?

  // Field Installation & Retrieval Tracking
  isInstalledAtSite Boolean         @default(false)
  installedAt       DateTime?
  installedTicketId String?
  damageNotes       String?
  retrievedAt       DateTime?

  // Custody Assignment (Direct Employee, Client, Group, or Vehicle)
  assignedUserId    String?
  assignedUser      User?            @relation("userAssignedInventory", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedClientId  String?
  assignedClient    Client?          @relation(fields: [assignedClientId], references: [id], onDelete: SetNull)
  assignedGroupId   String?
  assignedGroup     Group?           @relation("groupAssignedInventory", fields: [assignedGroupId], references: [id], onDelete: SetNull)
  assignedVehicleId String?
  assignedVehicle   Vehicle?         @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  tickets        TicketInventoryItem[]
  logs           InventoryLog[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, condition])
  @@index([assignedUserId])
  @@index([assignedGroupId])
  @@index([assignedClientId])
  @@index([category])
}

enum InventoryLogAction {
  CHECK_OUT
  CHECK_IN
  MAINTENANCE
  RETIRED
  CONDITION_CHANGE
  NOTE
}

model InventoryLog {
  id              String             @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  action          InventoryLogAction
  notes           String?
  performedById   String?
  performedBy     User?              @relation("inventoryLogUser", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
}

model TicketInventoryItem {
  id              String        @id @default(cuid())
  ticketId        String
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int           @default(1)
  notes           String?
  assignedAt      DateTime      @default(now())

  // Installation & Return Verification
  isInstalled     Boolean       @default(false)
  installedAt     DateTime?
  installedById   String?
  installedLat    Float?
  installedLng    Float?
  installedAddress String?
  proofPhoto      String?

  isReturned      Boolean       @default(false)
  returnedAt      DateTime?
  returnCondition String?       // "GOOD", "DAMAGED", "NEEDS_REPAIR"
  damageNotes     String?

  @@unique([ticketId, inventoryItemId])
}

// ============================================================================
// TICKETING SYSTEM
// ============================================================================

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  title           String
  description     String
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  dueDate         DateTime?

  // Creator
  createdById     String
  createdBy       User           @relation("ticketCreator", fields: [createdById], references: [id])

  // Assigned Direct Technician / Lead
  assignedUserId  String?
  assignedUser    User?          @relation("assignedTicketUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  // Assigned Group
  assignedGroupId String?
  assignedGroup   Group?         @relation(fields: [assignedGroupId], references: [id], onDelete: SetNull)

  // Linked Client
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Linked Vehicle
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Linked Project / Government Tender
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Assigned Inventory Devices
  inventoryItems  TicketInventoryItem[]

  // Resolution Notes, Proof of Work & Geolocation Audit Log
  resolutionNote  String?
  proofPhoto      String?
  resolveLat      Float?
  resolveLng      Float?
  resolveAddress  String?
  resolveAccuracy Float?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?          @relation("resolvedTicketUser", fields: [resolvedById], references: [id], onDelete: SetNull)

  // Discussion & Activity Comments
  comments        TicketComment[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, priority])
  @@index([assignedUserId])
  @@index([assignedGroupId])
  @@index([clientId])
  @@index([createdAt])
}

model TicketComment {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation("ticketCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  photo     String?
  lat       Float?
  lng       Float?
  accuracy  Float?
  address   String?
  parentId  String?
  parent    TicketComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TicketComment[] @relation("CommentReplies")
  createdAt DateTime        @default(now())
}

// ============================================================================
// GOVERNMENT TENDERS & PROJECT MANAGEMENT
// ============================================================================

enum ProjectStatus {
  PLANNING
  SURVEY
  MATERIAL_PROCUREMENT
  IN_PROGRESS
  TESTING_INSPECTION
  COMMISSIONED
  ON_HOLD
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStage {
  SURVEY_BOQ
  MATERIAL_DISPATCH
  CIVIL_POLE_SETUP
  FIBER_CABLING
  CAMERA_MOUNTING
  NETWORK_CONTROL_ROOM
  JOINT_INSPECTION
  HANDOVER_COMMISSIONING
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum SiteStatus {
  SURVEYED
  IN_PROGRESS
  COMPLETED
}

model Project {
  id              String          @id @default(cuid())
  code            String          @unique // e.g. "PRJ-2026-001"
  name            String
  tenderNo        String?         // Government Tender Reference No
  workOrderNo     String?         // Official Work Order / Sanction Order No
  tenderAuthority String?         // e.g. "Municipal Corporation", "Smart City Ltd", "Police Dept"
  description     String?
  status          ProjectStatus   @default(PLANNING)
  priority        ProjectPriority @default(MEDIUM)

  // Financials & Commercials
  contractValue   Float?          // Sanctioned Tender / Work Order Amount (₹)
  emdAmount       Float?          // Earnest Money Deposit / Bank Guarantee
  billingProgress Float?          @default(0) // Percentage of billing claimed/realized

  // Geographical Location & Site Details
  locationName    String?         // e.g. "Zone 4 Urban Surveillance"
  address         String?
  latitude        Float?
  longitude       Float?

  // Timeline
  workOrderDate   DateTime?       @db.Date
  startDate       DateTime?       @db.Date
  targetEndDate   DateTime?       @db.Date
  completedDate   DateTime?       @db.Date
  progress        Int             @default(0) // Overall completion % (0 to 100)

  // Client / Tender Authority Relation
  clientId        String?
  client          Client?         @relation("clientProjects", fields: [clientId], references: [id], onDelete: SetNull)

  // Execution Team & Vehicle
  groupId         String?
  group           Group?          @relation("groupAssignedProjects", fields: [groupId], references: [id], onDelete: SetNull)

  vehicleId       String?
  vehicle         Vehicle?        @relation("projectAssignedVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)

  // Project Lead / Manager
  managerId       String?
  manager         User?           @relation("projectManager", fields: [managerId], references: [id], onDelete: SetNull)

  // Creator
  createdById     String
  createdBy       User            @relation("projectCreator", fields: [createdById], references: [id])

  // Sub-entities & Relations
  milestones      ProjectMilestone[]
  sites           ProjectSite[]
  documents       ProjectDocument[]
  inventoryItems  InventoryItem[]
  tickets         Ticket[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, priority])
  @@index([managerId])
  @@index([clientId])
  @@index([groupId])
}

model ProjectMilestone {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  stage           MilestoneStage  @default(SURVEY_BOQ)
  status          MilestoneStatus @default(PENDING)
  order           Int             @default(1)
  progress        Int             @default(0) // 0 to 100

  dueDate         DateTime?       @db.Date
  completedAt     DateTime?

  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ProjectSite {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String          // e.g. "Junction 12 - ANPR Camera Pole #04"
  address         String?
  latitude        Float?
  longitude       Float?

  camerasPlanned  Int             @default(1)
  camerasInstalled Int            @default(0)
  status          SiteStatus      @default(SURVEYED)

  poleType        String?         // "OCTAGONAL_POLE", "SWAGED_POLE", "WALL_MOUNT", "EXISTING_ELECTRIC_POLE"
  powerSource     String?         // "SOLAR", "GRID_EB_METER", "UPS_BACKUP"
  notes           String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ProjectDocument {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title           String
  category        String          // "WORK_ORDER", "TENDER_NOTICE", "SURVEY_BOQ", "JIR_INSPECTION", "COMPLETION_CERTIFICATE", "INVOICE", "OTHER"
  fileUrl         String
  fileSize        String?
  
  uploadedById    String?
  uploadedBy      User?           @relation("projectDocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt       DateTime        @default(now())
}

// ============================================================================
// REAL-TIME INTERNAL TEAM CHAT & MESSAGING
// ============================================================================

enum ChatChannelType {
  CHANNEL
  DIRECT
  GROUP_LINKED
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  LOCATION
}

enum ChatParticipantRole {
  ADMIN
  MEMBER
}

model ChatChannel {
  id              String             @id @default(cuid())
  name            String?            // for public/private channels e.g. "general-announcements"
  type            ChatChannelType    @default(CHANNEL)
  description     String?
  isPrivate       Boolean            @default(false)
  avatar          String?
  
  createdById     String?
  createdBy       User?              @relation("createdChatChannels", fields: [createdById], references: [id], onDelete: SetNull)

  linkedGroupId   String?
  linkedGroup     Group?             @relation("groupChatChannel", fields: [linkedGroupId], references: [id], onDelete: SetNull)

  lastMessageAt   DateTime?          @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  participants    ChatParticipant[]
  messages        ChatMessage[]
}

model ChatParticipant {
  id          String              @id @default(cuid())
  channelId   String
  channel     ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ChatParticipantRole @default(MEMBER)
  lastReadAt  DateTime?           @default(now())
  isMuted     Boolean             @default(false)
  joinedAt    DateTime            @default(now())

  @@unique([channelId, userId])
}

model ChatMessage {
  id          String              @id @default(cuid())
  channelId   String
  channel     ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                @relation("sentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  content     String
  messageType ChatMessageType     @default(TEXT)
  fileUrl     String?
  fileName    String?
  fileSize    String?
  fileMime    String?

  replyToId   String?
  replyTo     ChatMessage?        @relation("messageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatMessage[]       @relation("messageReplies")

  isEdited    Boolean             @default(false)
  isDeleted   Boolean             @default(false)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  reactions   ChatMessageReaction[]

  @@index([channelId, createdAt])
  @@index([senderId])
}

model ChatMessageReaction {
  id          String              @id @default(cuid())
  messageId   String
  message     ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji       String
  createdAt   DateTime            @default(now())

  @@unique([messageId, userId, emoji])
}
